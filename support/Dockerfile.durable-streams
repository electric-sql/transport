FROM alpine:3.20

# Version can be overridden at build time
ARG VERSION=0.1.5

# Install curl for downloading and ca-certificates for HTTPS
RUN apk add --no-cache curl ca-certificates

WORKDIR /app

# Download and extract the durable-streams-server binary
RUN curl -fsSL "https://github.com/durable-streams/durable-streams/releases/download/v${VERSION}/durable-streams-server_${VERSION}_linux_amd64.tar.gz" \
    | tar -xz \
    && chmod +x durable-streams-server

# Create data directory for persistent storage
RUN mkdir -p /app/data

ENV PORT=4437
ENV HOST=0.0.0.0

EXPOSE 4437

# Run the server in dev mode (in-memory storage)
CMD ["./durable-streams-server", "dev"]
